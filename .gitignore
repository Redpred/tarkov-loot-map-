# Dependencies, local tools, game snapshots, captures and historical backups.
/node_modules/
/desktop/node_modules/
/work/
/dist/
/out/
__pycache__/
*.py[cod]
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# Credentials and machine-specific private state must never enter Git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ppk
.ssh/
known_hosts
known_hosts.old
authorized_keys
.netrc
.git-credentials
id_rsa*
id_ed25519*
**/private/
**/credentials.json
**/cookies.txt

# Old archives / extracted databases / tiled-map downloads.
/data/tmp/
/data/extracted/
/data/source/
/data/tiles/
/data/gmtiles/

# Game data, images and derived resources stay local or in separately licensed bundles.
/data/**
!/data/**/
!/data/spt-source.json
!/data/task-source.json
!/data/spt-audit.json
!/data/**/*LICENSE*
!/data/**/README.md
/site/data/**
!/site/data/**/
!/site/data/**/*LICENSE*
!/site/data/**/README.md
/site/previews/

# AI instructions, local conversations and maintenance journals stay on disk.
/.local/
/.agent/
/docs/
/更新计划.txt
AGENTS.md
AGENTS.local.md
CLAUDE.md
GEMINI.md
.codex/
.claude/
.cursor/
.agents/
.aider*
.windsurf/
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
/tools/eft-collector/README.md
/tools/eft-collector/PROVENANCE.md
/tools/eft-collector/remote.py
/deploy/files.txt

# Captures, local editors and operating-system state are not source releases.
.vscode/
.idea/
*.code-workspace
*.bundle
*.patch
*.har
coverage/
test-results/
playwright-report/
**/session.json
**/sessions/


# Imported marker bitmaps are resource inputs; project-authored SVG symbols stay tracked.
/icon/*.png
/icon/*.webp
