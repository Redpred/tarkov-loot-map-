{
  "name": "tarkov-loot-map-desktop",
  "version": "1.4.0-alpha.14",
  "private": true,
  "description": "塔科夫物资地图桌面版",
  "author": "Redpred",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "stage": "node ../scripts/desktop-stage.mjs",
    "pack": "npm run stage && electron-builder --config builder.json --win --x64 --dir --publish never",
    "dist": "npm run stage && electron-builder --config builder.json --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.7.3"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "14.0.3"
    },
    "@electron/universal": "3.0.6",
    "filelist": "2.0.2"
  }
}
